<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F0C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FFH4X"
            android:textColor="#00FF66"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="inyector propio"
            android:textColor="#7FD8A0"
            android:paddingBottom="18dp" />

        <TextView
            android:id="@+id/tv_estado_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Dar permiso de menu flotante" />

        <TextView
            android:id="@+id/tv_estado_archivos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:paddingTop="14dp"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/btn_archivos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Dar acceso a archivos" />

        <Button
            android:id="@+id/btn_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="3. Respaldar el original" />

        <Button
            android:id="@+id/btn_restaurar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurar el original" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perfiles (fase 2)"
            android:textColor="#7FD8A0"
            android:paddingTop="18dp" />

        <LinearLayout
            android:id="@+id/lista_perfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tv_resultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF66"
            android:paddingTop="18dp" />
    </LinearLayout>
</ScrollView>
