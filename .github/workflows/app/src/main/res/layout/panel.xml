<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="230dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FFH4X"
        android:textColor="#00FF66"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <Button
        android:id="@+id/p_backup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Respaldar original" />

    <Button
        android:id="@+id/p_restaurar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Restaurar original" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Perfiles"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:paddingTop="6dp" />

    <LinearLayout
        android:id="@+id/p_perfiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/p_cerrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cerrar menu" />
</LinearLayout>
